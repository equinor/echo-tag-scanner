{
    "name": "@equinor/echo-camera-web",
    "version": "5.0.0",
    "private": false,
    "main": "build/index.js",
    "source": "src/index.ts",
    "repository": "https://github.com/equinor/echo-camera-web",
    "license": "MIT",
    "scripts": {
        "start": "echo-build -s -d",
        "build": "echo-build -c && bash ./env.sh",
        "analyze": "echo-build -b",
        "lint": "eslint .",
        "lint:fix": "npm run lint -- --fix",
        "tunnel": "npx localtunnel --subdomain echoscanner --port 3001 --local-https --allow-invalid-cert --local-host localhost",
        "gitundo": "git reset HEAD~",
        "update-echo-deps": "npx @equinor/echo-update && npm i --force"
    },
    "devDependencies": {
        "@equinor/echo-base": "8.0.0",
        "@equinor/echo-cli": "8.0.0",
        "@equinor/echo-components": "8.0.0",
        "@equinor/echo-core": "8.0.0",
        "@equinor/echo-framework": "8.0.0",
        "@equinor/echo-search": "8.0.0",
        "@equinor/echo-utils": "8.0.0",
        "@equinor/eds-core-react": "2.6.4",
        "@equinor/eds-icons": "1.6.0",
        "@eslint/compat": "2.1.1",
        "@types/jest": "30.0.0",
        "@types/node": "20.11.27",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7",
        "@types/styled-components": "5.1.36",
        "@types/w3c-image-capture": "1.0.11",
        "@types/webpack-env": "1.18.8",
        "@typescript-eslint/parser": "8.73.0",
        "eslint": "10.15.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.7",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.14.0",
        "prettier": "3.10.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "styled-components": "6.6.0"
    },
    "overrides": {
        "eslint-plugin-react": {
            "eslint": "$eslint"
        },
        "@equinor/echo-cli": {
            "@oclif/core@5.1": "5.1.12",
            "ajv": {
                "fast-uri@3": "^3.1.9"
            }
        }
    },
    "peerDependencies": {
        "@equinor/echo-base": ">= 8.0.0 < 9.0.0",
        "@equinor/echo-components": ">= 8.0.0 < 9.0.0",
        "@equinor/echo-core": ">= 8.0.0 < 9.0.0",
        "@equinor/echo-framework": ">= 8.0.0 < 9.0.0",
        "@equinor/echo-search": ">= 8.0.0 < 9.0.0",
        "@equinor/echo-utils": ">= 8.0.0 < 9.0.0",
        "@equinor/eds-core-react": ">=2.6.4 <3.0.0",
        "@equinor/eds-icons": ">=1.6.0 <2.0.0",
        "react": ">= 19.3.1 < 20.0.0",
        "react-dom": ">= 19.3.1 < 20.0.0",
        "styled-components": ">=6.1.8 <7.0.0"
    }
}
