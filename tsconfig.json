{
  "include": [
    "src"
  ],
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "allowJs": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "module": "esnext",
    "removeComments": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "resolvePackageJsonExports": false,
    "types": [
      "@types/webpack-env",
      "@types/node",
      "@types/w3c-image-capture"
    ],
    "paths": {
      "@ui": [
        "./src/UI/"
      ],
      "@cameraLogic": [
        "./src/cameraLogic/"
      ],
      "@const": [
        "./src/const/"
      ],
      "@hooks": [
        "./src/hooks/"
      ],
      "@services": [
        "./src/services/"
      ],
      "@types": [
        "./src/types/"
      ],
      "@utils": [
        "./src/utils/"
      ]
    }
  }
}